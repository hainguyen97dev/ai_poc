# Copy this file to .env and fill in real values. .env is gitignored/dockerignored —
# never commit real keys. Both apps (agent.py and ada-service/main.py) load this file
# automatically on startup via python-dotenv.

# ── Provider selection ───────────────────────────────────────────────────────
# Which LlmGateway adapter infra/gateway_factory.py builds. One of: anthropic, minimax
LLM_PROVIDER=anthropic

# ── Anthropic (default provider) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=4000

# ── MiniMax ───────────────────────────────────────────────────────────────────
# Set LLM_PROVIDER=minimax above to use these instead. Confirm the exact model id
# and endpoint against MiniMax's current docs — https://www.minimax.io/platform/document
MINIMAX_API_KEY=
MINIMAX_MODEL=minimax3.0
MINIMAX_MAX_TOKENS=4000
# Optional overrides:
# MINIMAX_BASE_URL=https://api.minimax.io/v1/text/chatcompletion_v2
# MINIMAX_GROUP_ID=
